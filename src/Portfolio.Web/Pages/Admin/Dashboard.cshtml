        async function viewMessage(id) {
            const m = await api.get('/api/messages/' + id);
            const overlay = document.getElementById('modalOverlay');
            const content = document.getElementById('modalContent');
            overlay.classList.remove('hidden');
            content.innerHTML = `
                <div class="p-10">
                    <div class="flex justify-between items-start mb-8">
                        <div>
                            <h2 class="text-3xl font-bold">${m.name}</h2>
                            <p class="text-blue-400">${m.email}</p>
                        </div>
                        <p class="text-gray-500">${new Date(m.createdAt).toLocaleString()}</p>
                    </div>
                    <div class="bg-black/50 p-8 rounded-2xl border border-gray-800 mb-8">
                        <p class="text-gray-400 font-bold mb-2">Subject: ${m.subject || '(No Subject)'}</p>
                        <div class="text-gray-300 whitespace-pre-wrap">${m.body}</div>
                    </div>
                    <div class="flex justify-end">
                        <button onclick="closeModal()" class="px-8 py-3 bg-gray-800 text-white font-bold rounded-xl">Close</button>
                    </div>
                </div>
            `;
            // Refresh badge if it was unread
            if (!m.isRead) switchSection('messages');
        }

        async function deleteMessage(id) {
            if (!confirm('Are you sure you want to delete this message?')) return;
            if (await api.delete('/api/messages/' + id)) switchSection('messages');
        }

        async function handleAboutSubmit(e) {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            const originalText = btn.textContent;
            btn.textContent = 'Updating...';
            btn.disabled = true;

            try {
                const formData = new FormData(e.target);
                let imageUrl = formData.get('profileImage');
                const file = formData.get('imageFile');

                if (file && file.size > 0) {
                    const uploadRes = await api.upload(file);
                    imageUrl = uploadRes.url;
                }

                const data = {
                    bio: formData.get('bio'),
                    title: formData.get('title'),
                    subtitle: formData.get('subtitle'),
                    profileImage: imageUrl,
                    stats: [] // Handled separately or preserved
                };

                await api.put('/api/about', data);
                alert('About section updated!');
                switchSection('overview');
            } catch (err) {
                alert('Error: ' + err.message);
            } finally {
                btn.textContent = originalText;
                btn.disabled = false;
            }
        }

        async function saveSettings(e) {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            const originalText = btn.textContent;
            btn.textContent = 'Saving...';
            btn.disabled = true;

            try {
                const formData = new FormData(e.target);
                
                // Handle Profile Image (Legacy or shared)
                let profileImageUrl = formData.get('profileImage');
                const pFile = formData.get('profileImageFile');
                if (pFile && pFile.size > 0) {
                    const uploadRes = await api.upload(pFile);
                    profileImageUrl = uploadRes.url;
                }

                // Handle CV File
                let cvUrl = formData.get('cvUrl');
                const cvFile = formData.get('cvFile');
                if (cvFile && cvFile.size > 0) {
                    const uploadRes = await api.upload(cvFile);
                    cvUrl = uploadRes.url;
                }

                const data = Object.fromEntries(formData.entries());
                data.profileImage = profileImageUrl;
                data.cvFile = cvUrl;
                
                // Cleanup file objects that shouldn't be stringified as JSON
                delete data.profileImageFile;
                delete data.cvFile_input; // Placeholder if used
                delete data.cvUrl; // The hidden input name
                // Do NOT delete data.cvFile as it is our value!
                
                // Ensure we don't have multiple keys for same thing
                if (e.target.cvFile) delete data.cvFile; // Remove the File object entry if present
                data.cvFile = cvUrl; // Re-set the string value

                await api.put('/api/settings', data);
                alert('Settings saved!');
                switchSection('overview');
            } catch (err) {
                alert('Error: ' + err.message);
            } finally {
                btn.textContent = originalText;
                btn.disabled = false;
            }
        }

        // Initialize
        switchSection('overview');

        document.getElementById('logoutBtn').addEventListener('click', () => {
            localStorage.removeItem('token');
            window.location.href = '/Admin/Login';
        });
    </script>
