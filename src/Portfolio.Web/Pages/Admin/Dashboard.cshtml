        async function handleBlogSubmit(e, id) {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            const originalText = btn.textContent;
            btn.textContent = 'Saving...';
            btn.disabled = true;

            try {
                const formData = new FormData(e.target);
                let imageUrl = formData.get('coverImage');
                const file = formData.get('imageFile');

                if (file && file.size > 0) {
                    const uploadRes = await api.upload(file);
                    imageUrl = uploadRes.url;
                }

                const data = {
                    title: formData.get('title'),
                    slug: formData.get('slug'),
                    preview: formData.get('preview'),
                    content: formData.get('content'),
                    coverImage: imageUrl,
                    isPublished: formData.get('isPublished') === 'on'
                };
                
                const res = id ? await api.put(`/api/blog/${id}`, data) : await api.post('/api/blog', data);
                if (res) { closeModal(); switchSection('blog'); }
            } catch (err) {
                alert('Error: ' + err.message);
            } finally {
                btn.textContent = originalText;
                btn.disabled = false;
            }
        }

