        async function handleSkillItemSubmit(e, categoryId) {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.textContent = 'Adding...';
            btn.disabled = true;

            try {
                const formData = new FormData(e.target);
                let iconUrl = '';
