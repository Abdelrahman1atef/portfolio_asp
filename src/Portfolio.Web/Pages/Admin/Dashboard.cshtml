            background: #000; 
            border: 1px solid #1f2937; 
            color: #fff; 
            outline: none; 
            transition: all 0.3s;
        }
        .form-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1); }
    </style>
