@page
@model Portfolio.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Management Hub";
    Layout = "_AdminLayout";
}

<!-- Premium Dark Dashboard Shell -->
<div class="flex h-screen bg-gray-950 text-gray-100 overflow-hidden font-sans">
    
    <!-- Sidebar -->
    <aside class="w-72 bg-gray-900/50 backdrop-blur-xl border-r border-gray-800 flex flex-col">
        <div class="p-8 flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center font-bold text-white shadow-lg shadow-blue-500/20">
                A
            </div>
            <h2 class="text-xl font-bold tracking-tight">Admin Hub</h2>
        </div>

        <nav class="flex-1 px-6 space-y-1 py-4 overflow-y-auto custom-scrollbar">
            <button onclick="switchSection('overview')" data-section="overview" class="nav-link active w-full flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-200">
                <span>🏠</span>
                <span>Overview</span>
            </button>
            
            <div class="pt-6 pb-2 px-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Management</div>
            
            <button onclick="switchSection('about')" data-section="about" class="nav-link w-full flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-200">
                <span>👤</span>
                <span>About Me</span>
            </button>

            <button onclick="switchSection('projects')" data-section="projects" class="nav-link w-full flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-200">
                <span>📁</span>
                <span>Projects</span>
            </button>
            <button onclick="switchSection('blog')" data-section="blog" class="nav-link w-full flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-200">
                <span>✍️</span>
                <span>Blog Posts</span>
            </button>
            <button onclick="switchSection('skills')" data-section="skills" class="nav-link w-full flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-200">
                <span>⚡</span>
                <span>Skills</span>
            </button>
            <button onclick="switchSection('testimonials')" data-section="testimonials" class="nav-link w-full flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-200">
                <span>💬</span>
                <span>Testimonials</span>
            </button>
            <button onclick="switchSection('messages')" data-section="messages" class="nav-link w-full flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-200">
                <span>📩</span>
                <span>Messages</span>
                <span id="unreadBadge" class="hidden ml-auto px-2 py-0.5 rounded-full bg-blue-600 text-[10px] font-bold">NEW</span>
            </button>

            <div class="pt-6 pb-2 px-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">System</div>
            
            <button onclick="switchSection('settings')" data-section="settings" class="nav-link w-full flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-200">
                <span>⚙️</span>
                <span>Settings</span>
            </button>
        </nav>

        <div class="p-6 border-t border-gray-800">
            <button id="logoutBtn" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-400 hover:bg-red-500/10 hover:text-red-400 transition-all duration-200">
                <span>🚪</span>
                <span>Logout</span>
            </button>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col overflow-hidden bg-gradient-to-br from-gray-950 to-gray-900">
        <!-- Header -->
        <header class="h-20 flex items-center justify-between px-10 border-b border-gray-800/50 bg-gray-950/20 backdrop-blur-md">
            <h1 id="sectionTitle" class="text-2xl font-bold">Overview</h1>
            <div id="sectionActions" class="flex items-center space-x-4">
                <!-- Dynamic actions like "Add Project" go here -->
            </div>
        </header>

        <!-- Content Container -->
        <div id="mainContent" class="flex-1 overflow-y-auto p-10 custom-scrollbar scroll-smooth">
            <!-- Content will be injected here by JS -->
            <div class="flex items-center justify-center h-full">
                <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-blue-500"></div>
            </div>
        </div>
    </main>
</div>

<!-- Modal Container -->
<div id="modalOverlay" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-6">
    <div id="modalContent" class="bg-gray-900 border border-gray-800 rounded-3xl w-full max-w-4xl max-h-[90vh] overflow-y-auto shadow-2xl relative">
        <!-- Modal body injected by JS -->
    </div>
</div>

<style>
    .nav-link { color: #9ca3af; }
    .nav-link:hover { background: rgba(255, 255, 255, 0.05); color: #fff; }
    .nav-link.active { background: rgba(59, 130, 246, 0.1); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.2); }
    
    .glass-card { 
        background: rgba(17, 24, 39, 0.4); 
        backdrop-filter: blur(12px); 
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 24px;
        transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .glass-card:hover { border-color: rgba(59, 130, 246, 0.3); }

    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.2); }

    .fade-in { animation: fadeIn 0.4s ease-out forwards; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

@section Scripts {
    <script>
        const token = localStorage.getItem('token');
        if (!token) window.location.href = '/Admin/Login';

        const api = {
            get: (url) => fetch(url, { headers: { 'Authorization': `Bearer ${token}` } })
                .then(r => r.status === 401 ? (localStorage.removeItem('token'), window.location.href = '/Admin/Login') : (r.ok ? r.json() : r.json().then(e => { throw new Error(e.message || 'API Error'); }))),
            post: (url, data) => fetch(url, { 
                method: 'POST', 
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            }).then(r => r.ok ? r.json() : r.json().then(e => { throw new Error(e.message || 'Save failed'); })),
            put: (url, data) => fetch(url, { 
                method: 'PUT', 
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            }).then(r => r.ok ? r.json() : r.json().then(e => { throw new Error(e.message || 'Update failed'); })),
            delete: (url) => fetch(url, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` } })
                .then(r => r.ok ? true : r.json().then(e => { throw new Error(e.message || 'Delete failed'); })),
            upload: async (file) => {
                const formData = new FormData();
                formData.append('file', file);
                const res = await fetch('/api/files/upload', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}` },
                    body: formData
                });
                if (!res.ok) {
                    const error = await res.json();
                    throw new Error(error.message || 'Upload failed');
                }
                return await res.json();
            }
        };

        let currentSection = 'overview';
        const sections = {
            overview: async () => {
                const [projects, blogs, messages] = await Promise.all([
                    api.get('/api/projects'),
                    api.get('/api/blog'),
                    api.get('/api/messages')
                ]);

                const unreadCount = messages.filter(m => !m.isRead).length;
                document.getElementById('unreadBadge').classList.toggle('hidden', unreadCount === 0);

                return `
                    <div class="fade-in space-y-10">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                            ${renderStatCard('Total Projects', projects.length, '📁', 'blue')}
                            ${renderStatCard('Blog Posts', blogs.length, '✍️', 'purple')}
                            ${renderStatCard('Unread Messages', unreadCount, '📩', 'green')}
                        </div>
                        
                        <div class="glass-card p-8">
                            <h2 class="text-xl font-bold mb-6 flex items-center space-x-3">
                                <span>Recent Messages</span>
                                <span class="px-3 py-1 rounded-full bg-blue-500/10 text-blue-400 text-xs">${unreadCount} New</span>
                            </h2>
                            <div class="space-y-4">
                                ${messages.length === 0 ? '<p class="text-gray-500 py-10 text-center">No messages yet.</p>' : 
                                    messages.slice(0, 5).map(m => `
                                        <div class="flex items-center justify-between p-4 rounded-2xl bg-white/5 border border-white/5 hover:border-blue-500/30 transition-all">
                                            <div>
                                                <p class="font-bold ${!m.isRead ? 'text-white' : 'text-gray-400'}">${m.name}</p>
                                                <p class="text-sm text-gray-500">${m.subject || 'No Subject'}</p>
                                            </div>
                                            <button onclick="switchSection('messages')" class="text-blue-400 text-sm font-medium">View</button>
                                        </div>
                                    `).join('')
                                }
                            </div>
                        </div>
                    </div>
                `;
            },
            about: async () => {
                const a = await api.get('/api/about');
                return `
                    <div class="fade-in max-w-4xl mx-auto space-y-8">
                        <div class="glass-card p-10">
                            <h2 class="text-xl font-bold mb-8">About Me Information</h2>
                            <form onsubmit="handleAboutSubmit(event)" class="space-y-8">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                    <div class="space-y-4">
                                        <label class="text-sm font-bold text-gray-400">Profile Image</label>
                                        <div class="flex items-center space-x-6">
                                            <img id="aboutImagePreview" src="${a.profileImage || 'https://via.placeholder.com/200'}" class="w-32 h-32 rounded-3xl object-cover border-2 border-gray-800" />
                                            <input type="file" name="imageFile" onchange="previewImage(this, 'aboutImagePreview')" class="form-input flex-1" />
                                        </div>
                                        <input type="hidden" name="profileImage" value="${a.profileImage || ''}" />
                                    </div>
                                    <div class="space-y-6">
                                        <div class="space-y-2">
                                            <label class="text-sm font-bold text-gray-400">Display Title</label>
                                            <input type="text" name="title" value="${a.title || ''}" class="form-input" required />
                                        </div>
                                        <div class="space-y-2">
                                            <label class="text-sm font-bold text-gray-400">Subtitle</label>
                                            <input type="text" name="subtitle" value="${a.subtitle || ''}" class="form-input" />
                                        </div>
                                    </div>
                                </div>
                                <div class="space-y-2">
                                    <label class="text-sm font-bold text-gray-400">Bio</label>
                                    <textarea name="bio" class="form-input h-48" required>${a.bio || ''}</textarea>
                                </div>
                                <div class="flex justify-end pt-6 border-t border-gray-800">
                                    <button type="submit" class="px-10 py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-2xl shadow-xl shadow-blue-600/20 transition-all">Update About Me</button>
                                </div>
                            </form>
                        </div>
                    </div>
                `;
            },
            projects: async () => {
                const data = await api.get('/api/projects');
                document.getElementById('sectionActions').innerHTML = `<button onclick="openProjectModal()" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold shadow-lg shadow-blue-600/20 transition-all">+ Add Project</button>`;
                
                return `
                    <div class="fade-in grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        ${data.map(p => `
                            <div class="glass-card group overflow-hidden">
                                <div class="relative h-48 overflow-hidden">
                                    <img src="${p.image || 'https://via.placeholder.com/400x200'}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                    <div class="absolute inset-0 bg-gradient-to-t from-gray-950/80 to-transparent"></div>
                                    <span class="absolute top-4 right-4 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider ${p.isPublished ? 'bg-green-500/20 text-green-400' : 'bg-yellow-500/20 text-yellow-400'}">
                                        ${p.isPublished ? 'Published' : 'Draft'}
                                    </span>
                                </div>
                                <div class="p-6">
                                    <h3 class="font-bold text-lg mb-2">${p.title}</h3>
                                    <p class="text-sm text-gray-500 line-clamp-2 mb-6">${p.shortDescription || 'No description'}</p>
                                    <div class="flex items-center justify-between border-t border-gray-800 pt-6">
                                        <div class="flex space-x-2">
                                            <button onclick="openProjectModal(${p.id})" class="p-2 rounded-lg bg-white/5 hover:bg-blue-500/10 text-gray-400 hover:text-blue-400 transition-colors">✏️</button>
                                            <button onclick="deleteProject(${p.id})" class="p-2 rounded-lg bg-white/5 hover:bg-red-500/10 text-gray-400 hover:text-red-400 transition-colors">🗑️</button>
                                        </div>
                                        <a href="/project/${p.slug}" target="_blank" class="text-xs font-bold text-gray-500 hover:text-white transition-colors">VIEW SITE</a>
                                    </div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;
            },
            blog: async () => {
                const data = await api.get('/api/blog');
                document.getElementById('sectionActions').innerHTML = `<button onclick="openBlogModal()" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold">+ Add Post</button>`;
                return `
                    <div class="fade-in glass-card overflow-hidden">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-white/5 text-gray-400 text-xs uppercase tracking-wider">
                                    <th class="px-8 py-5 font-semibold">Post Title</th>
                                    <th class="px-8 py-5 font-semibold">Status</th>
                                    <th class="px-8 py-5 font-semibold">Date</th>
                                    <th class="px-8 py-5 font-semibold text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-800">
                                ${data.map(b => `
                                    <tr class="group hover:bg-white/[0.02] transition-colors">
                                        <td class="px-8 py-5">
                                            <p class="font-bold text-gray-200">${b.title}</p>
                                            <p class="text-xs text-gray-500">${b.excerpt || ''}</p>
                                        </td>
                                        <td class="px-8 py-5">
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase ${b.isPublished ? 'bg-green-500/20 text-green-400' : 'bg-yellow-500/20 text-yellow-400'}">
                                                ${b.isPublished ? 'Published' : 'Draft'}
                                            </span>
                                        </td>
                                        <td class="px-8 py-5 text-sm text-gray-500">${new Date(b.publishedAt || b.createdAt).toLocaleDateString()}</td>
                                        <td class="px-8 py-5 text-right">
                                            <div class="flex justify-end space-x-2">
                                                <button onclick="openBlogModal(${b.id})" class="p-2 rounded-lg bg-white/5 hover:bg-blue-500/10 text-gray-400 hover:text-blue-400">✏️</button>
                                                <button onclick="deleteBlog(${b.id})" class="p-2 rounded-lg bg-white/5 hover:bg-red-500/10 text-gray-400 hover:text-red-400">🗑️</button>
                                            </div>
                                        </td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                `;
            },
            messages: async () => {
                const data = await api.get('/api/messages');
                return `
                    <div class="fade-in glass-card overflow-hidden">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-white/5 text-gray-400 text-xs uppercase tracking-wider">
                                    <th class="px-8 py-5 font-semibold">Sender</th>
                                    <th class="px-8 py-5 font-semibold">Subject</th>
                                    <th class="px-8 py-5 font-semibold">Date</th>
                                    <th class="px-8 py-5 font-semibold text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-800">
                                ${data.map(m => `
                                    <tr class="group hover:bg-white/[0.02] transition-colors ${!m.isRead ? 'bg-blue-500/[0.03]' : ''}">
                                        <td class="px-8 py-5">
                                            <p class="font-bold text-gray-200">${m.name}</p>
                                            <p class="text-xs text-gray-500">${m.email}</p>
                                        </td>
                                        <td class="px-8 py-5">
                                            <p class="text-sm ${!m.isRead ? 'text-blue-300 font-medium' : 'text-gray-400'}">${m.subject || '(No Subject)'}</p>
                                        </td>
                                        <td class="px-8 py-5 text-sm text-gray-500">${new Date(m.createdAt).toLocaleDateString()}</td>
                                        <td class="px-8 py-5 text-right">
                                            <div class="flex justify-end space-x-2">
                                                <button onclick="viewMessage(${m.id})" class="p-2 rounded-lg bg-white/5 hover:bg-blue-500/10 text-gray-400 hover:text-blue-400">👁️</button>
                                                <button onclick="deleteMessage(${m.id})" class="p-2 rounded-lg bg-white/5 hover:bg-red-500/10 text-gray-400 hover:text-red-400">🗑️</button>
                                            </div>
                                        </td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                `;
            },
            skills: async () => {
                const data = await api.get('/api/skills');
                document.getElementById('sectionActions').innerHTML = `<button onclick="openSkillModal()" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold">+ Add Skill Category</button>`;
                return `
                    <div class="fade-in grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        ${data.map(cat => `
                            <div class="glass-card p-8 group">
                                <div class="flex justify-between items-center mb-6">
                                    <h3 class="text-xl font-bold text-blue-400">${cat.category}</h3>
                                    <div class="flex space-x-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                        <button onclick="editSkillCategory(${cat.id})" class="text-xs text-gray-400 hover:text-blue-400">Edit</button>
                                        <button onclick="deleteSkillCategory(${cat.id})" class="text-xs text-gray-400 hover:text-red-400">Delete</button>
                                    </div>
                                </div>
                                <div class="space-y-4">
                                    ${cat.skills.map((s, idx) => `
                                        <div class="group/item">
                                            <div class="flex items-center justify-between mb-1">
                                                <div class="flex items-center space-x-2">
                                                    <img src="${s.icon || 'https://via.placeholder.com/20'}" class="w-5 h-5 object-contain" />
                                                    <span class="text-sm text-gray-300">${s.name}</span>
                                                </div>
                                                <div class="flex items-center space-x-2">
                                                    <span class="text-xs font-bold text-gray-500">${s.level}%</span>
                                                    <button onclick="removeSkill(${cat.id}, ${idx})" class="text-[10px] text-gray-600 hover:text-red-400 opacity-0 group-hover/item:opacity-100">✕</button>
                                                </div>
                                            </div>
                                            <div class="w-full bg-white/5 rounded-full h-1">
                                                <div class="bg-blue-500 h-1 rounded-full" style="width: ${s.level}%"></div>
                                            </div>
                                        </div>
                                    `).join('')}
                                </div>
                                <button onclick="addSkillToCategory(${cat.id})" class="mt-8 w-full py-2 border border-dashed border-gray-800 hover:border-blue-500/50 rounded-xl text-xs text-gray-500 hover:text-blue-400 transition-all">+ Add Skill</button>
                            </div>
                        `).join('')}
                    </div>
                `;
            },
            testimonials: async () => {
                const data = await api.get('/api/testimonials');
                document.getElementById('sectionActions').innerHTML = `<button onclick="openTestimonialModal()" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold">+ Add Testimonial</button>`;
                return `
                    <div class="fade-in grid grid-cols-1 md:grid-cols-2 gap-8">
                        ${data.map(t => `
                            <div class="glass-card p-8 relative group">
                                <p class="text-gray-400 italic mb-6">"${t.quote}"</p>
                                <div class="flex items-center">
                                    <img src="${t.avatar || 'https://via.placeholder.com/100'}" class="w-12 h-12 rounded-full mr-4 object-cover" />
                                    <div>
                                        <p class="font-bold">${t.name}</p>
                                        <p class="text-xs text-gray-500">${t.role} &#64; ${t.company}</p>
                                    </div>
                                </div>
                                <div class="absolute top-8 right-8 flex space-x-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button onclick="openTestimonialModal(${t.id})" class="p-2 rounded-lg bg-white/5 hover:bg-blue-500/10 text-gray-400 hover:text-blue-400 transition-all">✏️</button>
                                    <button onclick="deleteTestimonial(${t.id})" class="p-2 rounded-lg bg-white/5 hover:bg-red-500/10 text-gray-400 hover:text-red-400 transition-all">🗑️</button>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;
            },
            settings: async () => {
                const s = await api.get('/api/settings');
                return `
                    <div class="fade-in max-w-3xl mx-auto space-y-8">
                        <div class="glass-card p-10">
                            <h2 class="text-xl font-bold mb-8">Personal Information</h2>
                            <form onsubmit="saveSettings(event)" class="space-y-6">
                                <div class="grid grid-cols-2 gap-6">
                                    <div class="space-y-2">
                                        <label class="text-sm font-semibold text-gray-400">Profile Image</label>
                                        <div class="flex items-center space-x-4">
                                            <img id="profileImagePreview" src="${s.profileImage || 'https://via.placeholder.com/100'}" class="w-16 h-16 rounded-xl object-cover border border-gray-800" />
                                            <input type="file" name="profileImageFile" onchange="previewImage(this, 'profileImagePreview')" class="form-input flex-1" />
                                        </div>
                                        <input type="hidden" name="profileImage" value="${s.profileImage || ''}" />
                                    </div>
                                    <div class="space-y-2">
                                        <label class="text-sm font-semibold text-gray-400">Full Name</label>
                                        <input type="text" name="name" value="${s.name}" class="w-full px-6 py-3 rounded-xl bg-gray-900 border border-gray-800 focus:border-blue-500 outline-none transition-all" />
                                    </div>
                                    <div class="space-y-2">
                                        <label class="text-sm font-semibold text-gray-400">Professional Email</label>
                                        <input type="email" name="email" value="${s.email}" class="w-full px-6 py-3 rounded-xl bg-gray-900 border border-gray-800 focus:border-blue-500 outline-none transition-all" />
                                    </div>
                                </div>
                                <div class="space-y-2">
                                    <label class="text-sm font-semibold text-gray-400">Professional CV (PDF)</label>
                                    <div class="flex items-center space-x-4">
                                        <div class="w-12 h-12 rounded-xl bg-red-500/10 flex items-center justify-center text-red-400 text-xl">📄</div>
                                        <input type="file" name="cvFile" class="form-input flex-1" accept=".pdf" />
                                        ${s.cvFile ? `<a href="${s.cvFile}" target="_blank" class="text-xs text-blue-400 hover:underline">View Current</a>` : ''}
