@page "/project/{slug}"
@model Portfolio.Web.Pages.ProjectModel
@{
    ViewData["Title"] = Model.Project?.Title ?? "Project Details";
}

@if (Model.Project != null)
{
    <div class="fade-in max-w-5xl mx-auto px-6 py-12">
        <!-- Breadcrumbs -->
        <nav class="flex mb-8 text-sm text-gray-500 font-medium">
            <a href="/" class="hover:text-blue-500 transition-colors">Home</a>
            <span class="mx-2">/</span>
            <a href="/projects" class="hover:text-blue-500 transition-colors">Projects</a>
            <span class="mx-2">/</span>
            <span class="text-gray-900 dark:text-gray-100">@Model.Project.Title</span>
        </nav>

        <!-- Project Header -->
        <div class="mb-12">
            <h1 class="text-4xl md:text-6xl font-black mb-6 bg-gradient-to-r from-blue-500 to-purple-600 bg-clip-text text-transparent">
                @Model.Project.Title
            </h1>
            <p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl leading-relaxed">
                @Model.Project.ShortDescription
            </p>
        </div>

        <!-- Featured Image -->
        <div class="rounded-3xl overflow-hidden shadow-2xl mb-16 border border-gray-200 dark:border-gray-800">
            <img src="@Model.Project.Image" alt="@Model.Project.Title" class="w-full h-auto object-cover max-h-[600px]" />
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
            <!-- Left Column: Details -->
            <div class="lg:col-span-2 space-y-16">
                <!-- Description -->
                <section>
                    <h2 class="text-2xl font-bold mb-6 border-l-4 border-blue-500 pl-4">About the Project</h2>
                    <div class="text-gray-600 dark:text-gray-300 leading-relaxed text-lg whitespace-pre-line">
                        @Model.Project.Description
                    </div>
                </section>

                <!-- Problem & Solution -->
                <div class="grid md:grid-cols-2 gap-10">
                    <section class="p-8 rounded-3xl bg-red-50 dark:bg-red-950/20 border border-red-100 dark:border-red-900/30">
                        <h3 class="text-xl font-bold mb-4 flex items-center text-red-600 dark:text-red-400">
                            <span class="mr-2">🚨</span> The Problem
                        </h3>
                        <p class="text-gray-600 dark:text-gray-400">@Model.Project.Problem</p>
                    </section>
                    <section class="p-8 rounded-3xl bg-green-50 dark:bg-green-950/20 border border-green-100 dark:border-green-900/30">
                        <h3 class="text-xl font-bold mb-4 flex items-center text-green-600 dark:text-green-400">
                            <span class="mr-2">💡</span> The Solution
                        </h3>
                        <p class="text-gray-600 dark:text-gray-400">@Model.Project.Solution</p>
                    </section>
                </div>

                <!-- Features -->
                @if (Model.Project.Features.Any())
                {
                    <section>
                        <h2 class="text-2xl font-bold mb-8 border-l-4 border-purple-500 pl-4">Key Features</h2>
                        <div class="grid md:grid-cols-2 gap-6">
                            @foreach (var feature in Model.Project.Features)
                            {
                                <div class="flex items-start p-4 rounded-2xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700">
                                    <span class="text-blue-500 mr-3 mt-1">✓</span>
                                    <span class="text-gray-700 dark:text-gray-300">@feature</span>
                                </div>
                            }
                        </div>
                    </section>
                }

                <!-- Architecture & Challenges -->
                <div class="space-y-12">
                    @if (!string.IsNullOrEmpty(Model.Project.Architecture))
                    {
                        <section>
                            <h2 class="text-2xl font-bold mb-6 border-l-4 border-blue-500 pl-4">Architecture</h2>
                            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">@Model.Project.Architecture</p>
                        </section>
                    }
                    @if (!string.IsNullOrEmpty(Model.Project.Challenges))
                    {
                        <section>
                            <h2 class="text-2xl font-bold mb-6 border-l-4 border-orange-500 pl-4">Challenges</h2>
                            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">@Model.Project.Challenges</p>
                        </section>
                    }
                </div>
            </div>

            <!-- Right Column: Sidebar -->
            <div class="space-y-10">
                <!-- Project Info Card -->
                <div class="p-8 rounded-3xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 sticky top-24 shadow-sm">
                    <h3 class="text-lg font-bold mb-6 uppercase tracking-wider text-gray-400">Project Info</h3>
                    
                    <div class="space-y-6">
                        <div>
                            <p class="text-xs font-bold text-gray-400 uppercase mb-1">Category</p>
                            <p class="text-gray-900 dark:text-white font-medium">@Model.Project.Category</p>
                        </div>

                        <div>
                            <p class="text-xs font-bold text-gray-400 uppercase mb-3">Tech Stack</p>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var tech in Model.Project.TechStack)
                                {
                                    <span class="px-3 py-1 text-xs font-bold rounded-lg bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800/50">
                                        @tech
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="pt-6 border-t border-gray-100 dark:border-gray-700 flex flex-col gap-4">
                            @if (!string.IsNullOrEmpty(Model.Project.LiveUrl))
                            {
                                <a href="@Model.Project.LiveUrl" target="_blank" class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl text-center font-bold transition-all shadow-lg shadow-blue-500/20">
                                    🚀 Launch Live Demo
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.Project.GithubUrl))
                            {
                                <a href="@Model.Project.GithubUrl" target="_blank" class="w-full py-4 bg-gray-900 hover:bg-black text-white rounded-2xl text-center font-bold transition-all flex items-center justify-center gap-2">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.841 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                                    View Source Code
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .fade-in { animation: fadeIn 0.6s ease-out forwards; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
</style>
