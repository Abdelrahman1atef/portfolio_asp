<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portfolio</title>
    <!-- Using Tailwind CDN for immediate styling without build step -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: { extend: {} }
        }
    </script>
</head>
<body class="bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-gray-100 transition-colors duration-300">
    
    <header class="fixed top-0 w-full z-50 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-800">
        <nav class="container mx-auto px-6 py-4 flex justify-between items-center">
            <a href="/" class="text-xl font-bold bg-gradient-to-r from-blue-500 to-purple-600 bg-clip-text text-transparent">
                Portfolio
            </a>
            <div class="hidden md:flex space-x-8">
                <a href="/#about" class="hover:text-blue-500 transition-colors">About</a>
                <a href="/#skills" class="hover:text-blue-500 transition-colors">Skills</a>
                <a href="/#projects" class="hover:text-blue-500 transition-colors">Projects</a>
                <a href="/#blog" class="hover:text-blue-500 transition-colors">Blog</a>
                <a href="/#contact" class="hover:text-blue-500 transition-colors">Contact</a>
            </div>
            <a href="/admin/login" class="px-4 py-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                Admin
            </a>
        </nav>
    </header>

    <main class="min-h-screen pt-20">
        @RenderBody()
    </main>

    <footer class="bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 py-12 mt-20">
        <div class="container mx-auto px-6 text-center text-gray-600 dark:text-gray-400">
            <p>&copy; @DateTime.Now.Year Abdelrahman Atef. All rights reserved.</p>
            <p class="mt-2 text-sm">Built with ASP.NET Core 8</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
